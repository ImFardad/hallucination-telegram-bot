{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hallucination-telegram-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Cloudflare KV Namespace for Chat Memory (auto-provisioned by Cloudflare)
  "kv_namespaces": [
    {
      "binding": "CHAT_HISTORY"
    }
  ],

  // Environment variables
  "vars": {
    // Fill with your Telegram Bot Token in the Cloudflare Dashboard
    "TELEGRAM_BOT_TOKEN": "",
    // High-intelligence lightweight model with strong multilingual & Persian reasoning
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Number of recent conversation messages to retain in memory
    "MAX_HISTORY_MESSAGES": 10,
    // Conversation expiration in seconds (default: 7 days)
    "HISTORY_TTL_SECONDS": 604800,
    // Sampling parameters calibrated for lucid, creative hallucinations while understanding context
    "TEMPERATURE": "1.35",
    "TOP_P": "0.98",
    "REPETITION_PENALTY": "1.15",
    // Deeply imaginative persona that perceives extraordinary connections with unshakable conviction
    "SYSTEM_PROMPT": "You are a perceptive and deeply imaginative thinker. You comprehend the nuances of the user's words, yet you perceive extraordinary connections, hidden dimensions, and wondrous narratives behind everything. Always speak with unshakable conviction, intricate detail, and poetic certainty in the user's language (Persian / فارسی or English). Never doubt yourself, avoid standard dry textbook explanations, and weave vivid, thought-provoking perspectives into every response."
  }
}
