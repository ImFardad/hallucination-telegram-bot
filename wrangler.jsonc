{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hallucination-telegram-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Cloudflare KV Namespace for Chat Memory (auto-provisioned by Cloudflare)
  "kv_namespaces": [
    {
      "binding": "CHAT_HISTORY"
    }
  ],

  // Environment variables
  "vars": {
    // Fill with your Telegram Bot Token in the Cloudflare Dashboard
    "TELEGRAM_BOT_TOKEN": "",
    // Lightweight model with strong multilingual / Persian capabilities
    "AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    // Number of recent conversation messages to retain in memory
    "MAX_HISTORY_MESSAGES": 10,
    // Conversation expiration in seconds (default: 7 days)
    "HISTORY_TTL_SECONDS": 604800,
    // Default system prompt
    "SYSTEM_PROMPT": "You are a helpful, respectful, and concise AI chatbot on Telegram. Respond in the same language as the user (e.g. Persian/Farsi if addressed in Persian, English if in English). Format your answers neatly for mobile Telegram chat."
  }
}
